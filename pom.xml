<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.5</version>
    <relativePath/>
  </parent>

  <groupId>com.exam</groupId>
  <artifactId>exam-backend</artifactId>
  <version>1.0.0</version>
  <name>exam-backend</name>
  <description>Exam proctoring backend – media storage, sessions, results</description>

  <properties>
    <!-- Change to 17 or 21 to match the JDK installed in your IntelliJ SDK list.
         Java 21 is the current LTS and is safest.
         Set to 17 for this machine (only JDK 17 is installed); the code uses no
         Java-21-only features (just var, text blocks, String.formatted). -->
    <java.version>17</java.version>
  </properties>

  <dependencies>

    <!-- ── Web (ResponseEntity, @RestController, @RequestMapping, MultipartFile …) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- ── JPA + Hibernate + jakarta.persistence.* -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- ── MySQL JDBC driver (runtime only) -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- ── Jackson (ObjectMapper, @RequestBody deserialization) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- ── Jackson Java-8 time module (LocalDateTime ↔ JSON without extra config) -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <!-- ── Lombok (@Data, @RequiredArgsConstructor, @NoArgsConstructor …)
             optional=true keeps it out of the fat-jar's compile classpath -->
    <!-- Source: https://mvnrepository.com/artifact/org.projectlombok/lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.46</version>
      <scope>compile</scope>
    </dependency>

    <!-- ── Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    
    <dependency>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-websocket</artifactId>
	</dependency>

  </dependencies>

  <build>
    <plugins>

      <!-- Spring Boot fat-jar packaging; exclude Lombok (annotation-only, not needed at runtime) -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- Compiler: use <release> (not source/target), wire Lombok annotation processor -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${java.version}</release>
          <!-- Lombok must be in annotationProcessorPaths so IntelliJ and Maven
               both expand @Data / @RequiredArgsConstructor / @NoArgsConstructor -->
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

    </plugins>
  </build>
</project>
